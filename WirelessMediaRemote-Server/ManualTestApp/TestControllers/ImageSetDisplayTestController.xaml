<Window x:Class="ManualTestApp.TestControllers.ImageSetDisplayTestController"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManualTestApp.TestControllers"
        mc:Ignorable="d"
        Title="ImageSetDisplayTestController" SizeToContent="WidthAndHeight">
    <Grid Width="Auto" Height="Auto">
        <StackPanel Margin="30">
            <StackPanel Orientation="Horizontal"
                        Height="30">
                <Button x:Name="PrevImageButton">
                    Prev Image
                </Button>

                <Separator Visibility="Hidden"
                           Width="40"/>

                <Button x:Name="NextImageButton">
                    Next Image
                </Button>
            </StackPanel>
            <Separator Visibility="Hidden"
                       Height="20"/>

            <Button x:Name="ClearImageSetButton"
                    Height="30">
                Clear Image Set
            </Button>
            <Separator Visibility="Hidden"
                       Height="20"/>

            <Button x:Name="ChangeImageSetButton"
                    Height="30">
                Change Image Set
            </Button>
            <Separator Visibility="Hidden"
                       Height="20"/>

            <Button x:Name="RunToEndButton"
                    Height="30">
                Run To End
            </Button>
        </StackPanel>
        
    </Grid>
</Window>
