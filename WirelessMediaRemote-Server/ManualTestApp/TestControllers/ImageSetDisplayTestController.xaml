<Window x:Class="ManualTestApp.TestControllers.ImageSetDisplayTestController"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManualTestApp.TestControllers"
        mc:Ignorable="d"
        Title="ImageSetDisplayTestController" SizeToContent="WidthAndHeight">
    <Grid Width="Auto" Height="Auto">
        <StackPanel Orientation="Horizontal"
                    Margin="30"
                    Height="30">
            <Button x:Name="PrevImageButton">
                Prev Image
            </Button>

            <Separator Visibility="Hidden"
                       Width="40"/>

            <Button x:Name="NextImageButton">
                Next Image
            </Button>
        </StackPanel>
    </Grid>
</Window>
