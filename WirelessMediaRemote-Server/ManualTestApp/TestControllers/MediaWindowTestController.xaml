<Window x:Class="ManualTestApp.TestControllers.MediaWindowTestController"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManualTestApp.TestControllers"
        mc:Ignorable="d"
        Title="MediaWindowTestController" SizeToContent="WidthAndHeight">
    <Grid Width="Auto" Height="Auto">
        <StackPanel Margin="30">
            <Button x:Name="SwitchToImageSetButton"
                    Height="30">
                Switch to Images Set
            </Button>
            <Separator Visibility="Hidden"
                       Height="20"/>
            
            <StackPanel Orientation="Horizontal"
                    Height="30">
                <Button x:Name="PrevImageButton">
                    Prev Image
                </Button>

                <Separator Visibility="Hidden"
                       Width="40"/>

                <Button x:Name="NextImageButton">
                    Next Image
                </Button>
            </StackPanel>
            
            <Separator Visibility="Hidden"
                   Height="60"/>

            

            <Button x:Name="SwitchToVideoButton"
                Height="30">
                Change to Video
            </Button>
            <Separator Visibility="Hidden"
                   Height="20"/>

            <Slider x:Name="VideoSlider" Maximum="100"
                    Width="Auto"
                    Height="20"/>
        </StackPanel>

    </Grid>
</Window>
