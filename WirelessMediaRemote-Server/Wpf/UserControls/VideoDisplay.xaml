<UserControl x:Class="Wpf.UserControls.VideoDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Wpf.UserControls"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:vm.uc="clr-namespace:ViewModels.UserControls;assembly=ViewModels"
             xmlns:behaviors="clr-namespace:Wpf.AttachedBehaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm.uc:VideoDisplayVM}">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayActive}" Value="False">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    
    <vlc:VideoView MediaPlayer="{Binding Player}">
        <i:Interaction.Behaviors>
            <behaviors:LoadedAwareBehavior IsLoaded="{Binding PlayerElementLoaded, Mode=OneWayToSource}"/>
        </i:Interaction.Behaviors>
    </vlc:VideoView>
</UserControl>
